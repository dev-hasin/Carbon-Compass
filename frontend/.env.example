# Frontend environment variables
# Copy this file to .env and adjust as needed
#
# On Vercel: set this in Project Settings → Environment Variables
# (Production + Preview) to the Render backend URL, e.g.
#   VITE_API_BASE_URL=https://carbon-compass-api.onrender.com
# Vite bakes it in at build time, so changing it triggers a redeploy.

# Backend API URL
VITE_API_BASE_URL=http://localhost:8000
