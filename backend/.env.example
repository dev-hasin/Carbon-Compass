# Backend environment variables
# Copy this file to .env and fill in your keys

# Geocoding (OpenCage)
GEOCODING_API_KEY=

# Sentinel Hub
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# Alibaba Cloud Model Studio (Qwen)
QWEN_API_KEY=

# Alibaba Cloud OSS (optional — falls back to local filesystem)
ALIBABA_OSS_ACCESS_KEY_ID=
ALIBABA_OSS_ACCESS_KEY_SECRET=
ALIBABA_OSS_BUCKET_NAME=
ALIBABA_OSS_ENDPOINT=

# Supabase Storage (optional — falls back to local filesystem)
# Create a free project at supabase.com → Storage → create bucket "carbon-compass"
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_BUCKET=carbon-compass

# Scoring configuration
CONFIDENCE_THRESHOLD=0.5
SCORING_WEIGHT_SATELLITE=0.4
SCORING_WEIGHT_DISCLOSURE=0.4
SCORING_WEIGHT_SHIPPING=0.2

# Server
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
