# Backend environment variables
# Copy this file to .env and fill in your keys

# Geocoding (OpenCage)
GEOCODING_API_KEY=

# Sentinel Hub
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# Alibaba Cloud Model Studio (Qwen) — any OpenAI-compatible endpoint works
QWEN_API_KEY=
# Optional: override for proxies/gateways (default: https://dashscope.aliyuncs.com/compatible-mode/v1)
# QWEN_BASE_URL=
# QWEN_TEXT_MODEL=qwen-max
# QWEN_VISION_MODEL=qwen-vl-max

# Alibaba Cloud OSS (legacy durable storage — superseded by Supabase below)
ALIBABA_OSS_ACCESS_KEY_ID=
ALIBABA_OSS_ACCESS_KEY_SECRET=
ALIBABA_OSS_BUCKET_NAME=
ALIBABA_OSS_ENDPOINT=

# Supabase Storage (preferred durable storage — used when URL + anon key are
# set; unset → local filesystem cache only). Create a free project at
# supabase.com → Storage → create bucket "carbon-compass" (private is fine).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_BUCKET=carbon-compass

# Scoring configuration
CONFIDENCE_THRESHOLD=0.5
SCORING_WEIGHT_SATELLITE=0.4
SCORING_WEIGHT_DISCLOSURE=0.4
SCORING_WEIGHT_SHIPPING=0.2

# Server
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Auth (single admin account + exporter self-registration)
# AUTH_SECRET: leave unset and a random signing secret is generated once and
# persisted to data/auth_secret.key. Set it only when multiple instances must
# share sessions. Never commit the generated key.
# AUTH_SECRET=
AUTH_TOKEN_EXPIRY_HOURS=12
# The single admin account is seeded on FIRST startup only.
# Set a strong ADMIN_PASSWORD before first startup, or sign in afterwards and
# rotate it via the user menu -> Change Password (all old sessions are revoked).
# ADMIN_EMAIL=admin@carbon-compass.local
# ADMIN_PASSWORD=
